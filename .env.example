# SVAN real product data setup
#
# Best MVP option:
# 1. Use creator/curated uploads for the social outfit feed.
# 2. Use affiliate product feeds for shoppable product cards.
# 3. Use Cuelinks to convert product URLs into trackable affiliate links.

# Optional: one or more CSV/TSV/JSON product feed URLs from Admitad, Rakuten,
# Cuelinks-supported partners, or another affiliate network.
# Separate multiple URLs with commas.
SVAN_PRODUCT_FEED_URLS=

# Optional: local CSV/TSV/JSON product feed path for development.
# Example:
# SVAN_PRODUCT_FEED_FILE=C:\Users\Ajayy\Documents\Codex\feeds\fashion-products.csv
SVAN_PRODUCT_FEED_FILE=

# Optional: local JSON file of consented creator/curated outfit posts.
# If omitted, SVAN uses the seeded demo outfits.
SVAN_OUTFIT_FEED_FILE=

# Optional: local cache for app-native product-page scraping.
# This keeps the shop sheet fast and avoids refetching retailer pages on every tap.
SVAN_SCRAPE_CACHE_FILE=data/scrape-cache.json
SVAN_SCRAPE_CACHE_TTL_HOURS=12
SVAN_SCRAPE_TIMEOUT_MS=8000
SVAN_ENABLE_BROWSER_SCRAPER=true
PLAYWRIGHT_BROWSERS_PATH=work/ms-playwright

# Optional: Cuelinks API key. When present, SVAN converts product buy URLs into
# affiliate links before sending them to the frontend.
CUELINKS_API_KEY=
CUELINKS_BASE_URL=https://developers.cuelinks.com/pub_api/v3
